---
/**
 * Container Component - Phase 2.6
 *
 * A responsive container with max-width constraints and horizontal padding.
 * Provides consistent content width across the site.
 */
import type {ContainerProps} from '../../types';

interface Props extends ContainerProps {
  /** HTML element to render as */
  as?: 'div' | 'article' | 'section' | 'header' | 'footer';
}

const {size = 'default', className = '', as: Element = 'div'}: Props =
  Astro.props;

const sizeClasses: Record<string, string> = {
  narrow: 'max-w-2xl', // 672px - for text-heavy content
  default: 'max-w-5xl', // 1024px - standard content
  wide: 'max-w-7xl', // 1280px - for wide layouts
  full: 'max-w-none', // no max-width constraint
};
---

<Element
  class:list={[
    'mx-auto w-full px-4 sm:px-6 lg:px-8',
    sizeClasses[size],
    className,
  ]}
>
  <slot />
</Element>
