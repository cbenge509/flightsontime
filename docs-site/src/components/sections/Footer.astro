---
/**
 * Footer Section - Phase 3.4
 *
 * Minimal footer with team credits, GitHub link, and UC Berkeley attribution.
 * Not full viewport height.
 */
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
import {team} from '../../lib/data';
---

<Section
  id="footer"
  background="gradient-reverse"
  fullHeight={false}
  align="end"
  padding="large"
>
  <Container as="footer" size="wide">
    <div class="footer-content">
      {/* Team section */}
      <div class="team-section">
        <h3 class="text-sm font-semibold text-slate-400 uppercase tracking-wider mb-4">
          Team
        </h3>
        <ul class="team-list">
          {
            team.map((member) => (
              <li>
                <a
                  href={member.linkedin}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="team-link"
                >
                  {member.name}
                  <svg
                    class="external-icon"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                    />
                  </svg>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      {/* Project section */}
      <div class="project-section">
        <h3 class="text-sm font-semibold text-slate-400 uppercase tracking-wider mb-4">
          Project
        </h3>
        <ul class="project-links">
          <li>
            <a
              href="https://github.com/cbenge509/flightsontime"
              target="_blank"
              rel="noopener noreferrer"
              class="project-link"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path
                  fill-rule="evenodd"
                  d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
                  clip-rule="evenodd"></path>
              </svg>
              <span>View on GitHub</span>
            </a>
          </li>
        </ul>
      </div>

      {/* Attribution section */}
      <div class="attribution-section">
        <h3 class="text-sm font-semibold text-slate-400 uppercase tracking-wider mb-4">
          Attribution
        </h3>
        <div class="attribution-content">
          <p class="text-slate-500 text-sm mb-2">
            UC Berkeley School of Information
          </p>
          <p class="text-slate-500 text-sm mb-2">
            Master of Information and Data Science
          </p>
          <p class="text-slate-400 text-sm font-medium">
            W261: Machine Learning at Scale
          </p>
          <p class="text-slate-500 text-sm mt-2">Fall 2020</p>
        </div>
      </div>
    </div>

    {/* Bottom bar */}
    <div class="bottom-bar">
      <p class="text-slate-600 text-xs">
        &copy; 2020 Flight Delay Prediction Team. Built with PySpark, TensorFlow,
        and distributed computing on Azure Databricks.
      </p>
    </div>
  </Container>
</Section>

<style>
  .footer-content {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  @media (min-width: 640px) {
    .footer-content {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .footer-content {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .team-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .team-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--color-slate-300);
    font-size: 0.875rem;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .team-link:hover {
    color: var(--color-sky-400);
  }

  .external-icon {
    width: 0.875rem;
    height: 0.875rem;
    opacity: 0.5;
  }

  .project-links {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .project-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-slate-300);
    font-size: 0.875rem;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .project-link:hover {
    color: var(--color-sky-400);
  }

  .attribution-content {
    text-align: left;
  }

  .bottom-bar {
    padding-top: 1.5rem;
    text-align: center;
  }
</style>
